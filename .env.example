# Export in your shell or load using node --env-file=.env server/server.js.
# Generate independent values with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DASHBOARD_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEVICE_TOKEN=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
DEVICE_ID=ESP32-SILO-01
DEVICE_PIT_ID=pit-a
DATABASE_PATH=./server/data/telemetry.sqlite
PUBLIC_ORIGIN=http://localhost:3000,http://localhost:5001
# For multiple devices use an ignored JSON file instead of DEVICE_TOKEN:
# DEVICE_CREDENTIALS_FILE=/absolute/path/device-credentials.json
